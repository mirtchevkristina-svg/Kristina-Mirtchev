# Replit-Konfiguration fuer SUBSUMO
# Run-Button startet den Server; Replit setzt $PORT selbst.
run = "npm start"
entrypoint = "server/index.js"
modules = ["nodejs-22"]

hidden = [".config", "package-lock.json", "node_modules", "data"]

[nix]
channel = "stable-24_05"

[env]
NODE_ENV = "development"

[deployment]
run = ["sh", "-c", "npm start"]
deploymentTarget = "autoscale"
build = ["sh", "-c", "npm install && npm run seed"]

[[ports]]
localPort = 3000
externalPort = 80

[unitTest]
language = "nodejs"
