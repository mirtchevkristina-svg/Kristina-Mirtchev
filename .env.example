# Laufzeitumgebung: development | test | production
NODE_ENV=development

# Server
PORT=3001
PUBLIC_WEB_URL=http://localhost:5173

# Datenbank
DATABASE_URL=postgres://postgres:postgres@localhost:5432/forderungsportal
# memory = In-Memory-Repository (nur Entwicklung/Tests), postgres = Drizzle
REPOSITORY_DRIVER=memory

# Clerk (serverseitige Identitaet). Im Dev-Modus optional.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# dev-header erlaubt Identitaet per Header - NUR ausserhalb der Produktion
AUTH_DRIVER=dev-header

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Feature-Flags / Startup-Checks
# Muss in Produktion false sein, sonst bricht der Startup-Check ab.
ALLOW_DEMO_CONFIG=true
ENABLE_DEMO_PORTAL=true
