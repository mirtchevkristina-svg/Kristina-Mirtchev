# --- Betrieb ---
PORT=3000
NODE_ENV=development
SESSION_SECRET=bitte-aendern-vor-launch

# --- Content-Governance (Kapitel 8 des Business Case) ---
# false = nur juristisch geprueftes Material fliesst in Scores und Ausspielung.
# Muss vor dem kommerziellen Launch auf false stehen.
CONTENT_ALLOW_UNREVIEWED=true

# --- Zahlung (Kapitel 7) ---
# mock = kein echter Zahlungsfluss, nur Bestell- und Einwilligungsprotokoll.
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=

# --- KI-Tutor (Kapitel 9/16) - bewusst standardmaessig AUS ---
AI_TUTOR_ENABLED=false
ANTHROPIC_API_KEY=
# Hartes Kostenlimit je Nutzer und Zyklus in Euro-Cent (Abbruchkriterium Kapitel 14)
AI_BUDGET_CENTS_PER_USER=300

# --- Admin-Zugang fuer das Review-Backoffice ---
ADMIN_TOKEN=lokaler-dev-token
