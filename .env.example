# Eine der beiden Optionen setzen:

# Variante A (empfohlen): eigener Backend-Proxy, der die Claude-API aufruft.
# Akzeptiert POST /api/scan mit Messages-API-Payload und gibt die Antwort zurück.
# VITE_SCANNER_PROXY_URL=/api/scan

# Variante B (nur Entwicklung/Demo!): direkter Browser-Aufruf mit API-Key.
# ACHTUNG: Der Key wird in den Client gebundled — niemals in Produktion verwenden.
# VITE_ANTHROPIC_API_KEY=sk-ant-...
