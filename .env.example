# Port (Replit setzt diesen automatisch)
PORT=3000

# Erlaubte Kanzlei-E-Mail-Domains (Komma-getrennt) für die Anmeldung
FIRM_EMAIL_DOMAINS=westtorlex.com

# DEMO_LOGIN=true  -> jede E-Mail wird akzeptiert (nur zum Ausprobieren)
# DEMO_LOGIN=false -> nur Adressen der oben genannten Kanzlei-Domains
DEMO_LOGIN=true
